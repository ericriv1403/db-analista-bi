let
    Origen =
        Sql.Database(
            "10.0.2.27\\DataWareHousse,8699",
            "GestionHumana",
            [
                Query = "
SET NOCOUNT ON;
SET DATEFIRST 1;

DECLARE @FechaFin    date = CAST(GETDATE() AS date);
DECLARE @FechaInicio date;

-- =========================================================
-- 0) Fecha inicio histórica (primera salida disponible con filtros)
-- =========================================================
SELECT
    @FechaInicio = MIN(CAST(hp.Fecha_Fin_Evento AS date))
FROM dbo.Historia_Personal hp
INNER JOIN dbo.GHU_View_Maestro_Empleados me
    ON hp.Codigo_Personal = me.Codigo_Personal
INNER JOIN dbo.Personal p
    ON hp.Codigo_Personal = p.Codigo_Personal
WHERE
    hp.Tipo_de_Evento = 'IS'
    AND hp.Fecha_Inicio_Evento IS NOT NULL
    AND hp.Fecha_Fin_Evento    IS NOT NULL
    AND me.Codigo_Personal NOT LIKE 'VC%'
    AND me.Clasificacion_Personal IN ('AGR','OCAS','ADM')
    AND p.Finca IN ('MH','SJ')
    AND p.A_Empresa = '2 - STARFLOWERS CIA. LTDA.';

IF @FechaInicio IS NULL
    SET @FechaInicio = '2020-09-01';

WITH
-- =========================================================
-- 1) Dimensiones (listas) para grid completo
-- =========================================================
DimArea AS (
    SELECT DISTINCT
        ISNULL(UPPER(LTRIM(RTRIM(p.Area_Original))), '(SIN AREA)') AS Area
    FROM dbo.Personal p
    INNER JOIN dbo.GHU_View_Maestro_Empleados me
        ON p.Codigo_Personal = me.Codigo_Personal
    WHERE
        me.Codigo_Personal NOT LIKE 'VC%'
        AND me.Clasificacion_Personal IN ('AGR','OCAS','ADM')
        AND p.Finca IN ('MH','SJ')
        AND p.A_Empresa = '2 - STARFLOWERS CIA. LTDA.'
),
DimClasif AS (
    SELECT 'AGR'  AS Clasif, 1 AS OrdenClasif
    UNION ALL SELECT 'OCAS', 2
    UNION ALL SELECT 'ADM',  3
),
DimFinca AS (
    SELECT 'MH' AS Finca, 1 AS OrdenFinca
    UNION ALL SELECT 'SJ', 2
),
DimSexo AS (
    SELECT 'Femenino' AS Sexo, 1 AS OrdenSexo
    UNION ALL SELECT 'Masculino', 2
),
DimEdad AS (
    SELECT '< 18'      AS Edad, 1 AS OrdenEdad
    UNION ALL SELECT '18 - 24',  2
    UNION ALL SELECT '25 - 34',  3
    UNION ALL SELECT '35 - 44',  4
    UNION ALL SELECT '45 - 54',  5
    UNION ALL SELECT '55+',      6
),
DimAntig AS (
    SELECT '0 - 30'      AS Antiguedad, 1 AS OrdenAntig
    UNION ALL SELECT '31 - 60',     2
    UNION ALL SELECT '61 - 180',    3
    UNION ALL SELECT '181 - 365',   4
    UNION ALL SELECT '> 365',       5
),

-- =========================================================
-- 2) Calendario semanal (lunes) + Semana YYWW (week-mid)
-- =========================================================
Params AS (
    SELECT
        CAST(DATEADD(DAY, 1 - DATEPART(WEEKDAY, @FechaInicio), @FechaInicio) AS date) AS StartMonday,
        @FechaFin AS FechaFin
),
CalendarioSemanas AS (
    SELECT
        p.StartMonday AS Dia,
        CAST(RIGHT(CONVERT(varchar(4), YEAR(DATEADD(DAY, 3, p.StartMonday))), 2) AS int) * 100
        + DATEPART(WEEK, DATEADD(DAY, 3, p.StartMonday)) AS Semana
    FROM Params p
    UNION ALL
    SELECT
        CAST(DATEADD(DAY, 7, c.Dia) AS date) AS Dia,
        CAST(RIGHT(CONVERT(varchar(4), YEAR(DATEADD(DAY, 3, DATEADD(DAY, 7, c.Dia)))), 2) AS int) * 100
        + DATEPART(WEEK, DATEADD(DAY, 3, DATEADD(DAY, 7, c.Dia))) AS Semana
    FROM CalendarioSemanas c
    CROSS JOIN Params p
    WHERE DATEADD(DAY, 7, c.Dia) <= p.FechaFin
),

-- =========================================================
-- 3) Grid completo: Semana × Clasif × Finca × Area × Sexo × Edad × Antiguedad
-- =========================================================
GridCompleto AS (
    SELECT
        cal.Semana,

        c.Clasif,
        f.Finca,
        a.Area,
        s.Sexo,
        e.Edad,
        ag.Antiguedad,

        c.OrdenClasif,
        f.OrdenFinca,
        s.OrdenSexo,
        e.OrdenEdad,
        ag.OrdenAntig
    FROM CalendarioSemanas cal
    CROSS JOIN DimClasif c
    CROSS JOIN DimFinca  f
    CROSS JOIN DimArea   a
    CROSS JOIN DimSexo   s
    CROSS JOIN DimEdad   e
    CROSS JOIN DimAntig  ag
),

-- =========================================================
-- 4) Hechos: SALIDAS (IS con Fecha_Fin_Evento)
--    + Semana
--    + Edad y Antiguedad acumulada al dia de salida
-- =========================================================
BaseSalidas AS (
    SELECT
        UPPER(LTRIM(RTRIM(hp.Codigo_Personal))) AS Codigo_Personal,
        CAST(hp.Fecha_Inicio_Evento AS date)    AS Fecha_Ingreso,
        CAST(hp.Fecha_Fin_Evento    AS date)    AS Fecha_Salida,
        DATEDIFF(DAY, CAST(hp.Fecha_Inicio_Evento AS date), CAST(hp.Fecha_Fin_Evento AS date)) AS DiasSegmento,

        UPPER(LTRIM(RTRIM(p.Sexo)))             AS SexoRaw,
        CAST(p.Fecha_de_Nacimiento AS date)     AS Fecha_Nacimiento,

        ISNULL(UPPER(LTRIM(RTRIM(p.Area_Original))), '(SIN AREA)') AS Area,
        UPPER(LTRIM(RTRIM(p.Finca)))            AS Finca,
        UPPER(LTRIM(RTRIM(me.Clasificacion_Personal))) AS Clasif

    FROM dbo.Historia_Personal hp
    INNER JOIN dbo.GHU_View_Maestro_Empleados me
        ON hp.Codigo_Personal = me.Codigo_Personal
    INNER JOIN dbo.Personal p
        ON hp.Codigo_Personal = p.Codigo_Personal
    WHERE
        hp.Tipo_de_Evento = 'IS'
        AND hp.Fecha_Inicio_Evento IS NOT NULL
        AND hp.Fecha_Fin_Evento    IS NOT NULL
        AND CAST(hp.Fecha_Fin_Evento AS date) BETWEEN @FechaInicio AND @FechaFin
        AND me.Codigo_Personal NOT LIKE 'VC%'
        AND me.Clasificacion_Personal IN ('AGR','OCAS','ADM')
        AND p.Finca IN ('MH','SJ')
        AND p.A_Empresa = '2 - STARFLOWERS CIA. LTDA.'
),

SalidasEnriquecidas AS (
    SELECT
        b.*,

        -- WeekMid (jueves) para codificar Semana YYWW
        CAST(
            DATEADD(
                DAY, 3,
                DATEADD(DAY, 1 - DATEPART(WEEKDAY, b.Fecha_Salida), b.Fecha_Salida)
            ) AS date
        ) AS WeekMid,

        -- Edad en años al dia de salida
        CASE
            WHEN b.Fecha_Nacimiento IS NULL THEN NULL
            ELSE FLOOR(DATEDIFF(DAY, b.Fecha_Nacimiento, b.Fecha_Salida) / 365.25)
        END AS EdadAnios,

        -- Antiguedad acumulada (sumatoria de segmentos cerrados hasta esta salida)
        SUM(b.DiasSegmento) OVER (
            PARTITION BY b.Codigo_Personal
            ORDER BY b.Fecha_Ingreso
            ROWS UNBOUNDED PRECEDING
        ) AS AntigAcumDias
    FROM BaseSalidas b
),

SalidasClasificadas AS (
    SELECT
        CAST(RIGHT(CONVERT(varchar(4), YEAR(s.WeekMid)), 2) AS int) * 100
        + DATEPART(WEEK, s.WeekMid) AS Semana,

        s.Clasif,
        s.Finca,
        s.Area,

        CASE
            WHEN s.SexoRaw IN ('F','FEMENINO') THEN 'Femenino'
            WHEN s.SexoRaw IN ('M','MASCULINO','H','HOMBRE') THEN 'Masculino'
            ELSE NULL
        END AS Sexo,

        CASE
            WHEN s.EdadAnios IS NULL THEN NULL
            WHEN s.EdadAnios < 18 THEN '< 18'
            WHEN s.EdadAnios BETWEEN 18 AND 24 THEN '18 - 24'
            WHEN s.EdadAnios BETWEEN 25 AND 34 THEN '25 - 34'
            WHEN s.EdadAnios BETWEEN 35 AND 44 THEN '35 - 44'
            WHEN s.EdadAnios BETWEEN 45 AND 54 THEN '45 - 54'
            ELSE '55+'
        END AS Edad,

        CASE
            WHEN s.AntigAcumDias IS NULL THEN NULL
            WHEN s.AntigAcumDias <= 30  THEN '0 - 30'
            WHEN s.AntigAcumDias <= 60  THEN '31 - 60'
            WHEN s.AntigAcumDias <= 180 THEN '61 - 180'
            WHEN s.AntigAcumDias <= 365 THEN '181 - 365'
            ELSE '> 365'
        END AS Antiguedad

    FROM SalidasEnriquecidas s
),

-- =========================================================
-- 5) Agregado: conteo de salidas por Semana y todas las dimensiones
-- =========================================================
Hechos AS (
    SELECT
        Semana,
        Clasif,
        Finca,
        Area,
        Sexo,
        Edad,
        Antiguedad,
        COUNT_BIG(1) AS Valor
    FROM SalidasClasificadas
    WHERE
        Sexo IS NOT NULL
        AND Edad IS NOT NULL
        AND Antiguedad IS NOT NULL
        AND Clasif IN ('AGR','OCAS','ADM')
        AND Finca IN ('MH','SJ')
    GROUP BY
        Semana, Clasif, Finca, Area, Sexo, Edad, Antiguedad
)

-- =========================================================
-- 6) Salida final: grid completo con ceros
-- =========================================================
SELECT
    g.Semana,
    g.Clasif,
    g.Finca,
    g.Area,
    g.Sexo,
    g.Edad,
    g.Antiguedad,
    ISNULL(h.Valor, 0) AS Valor,

    -- columnas de orden (útiles para sort en Power BI; puedes ocultarlas)
    g.OrdenClasif,
    g.OrdenFinca,
    g.OrdenSexo,
    g.OrdenEdad,
    g.OrdenAntig

FROM GridCompleto g
LEFT JOIN Hechos h
    ON  g.Semana      = h.Semana
    AND g.Clasif      = h.Clasif
    AND g.Finca       = h.Finca
    AND g.Area        = h.Area
    AND g.Sexo        = h.Sexo
    AND g.Edad        = h.Edad
    AND g.Antiguedad  = h.Antiguedad
ORDER BY
    g.Semana,
    g.OrdenClasif, g.OrdenFinca, g.Area,
    g.OrdenSexo, g.OrdenEdad, g.OrdenAntig
OPTION (MAXRECURSION 32767);
                "
            ]
        ),

    #"Tipo cambiado" =
        Table.TransformColumnTypes(
            Origen,
            {
                {"Semana", Int64.Type},
                {"Clasif", type text},
                {"Finca", type text},
                {"Area", type text},
                {"Sexo", type text},
                {"Edad", type text},
                {"Antiguedad", type text},
                {"Valor", Int64.Type},
                {"OrdenClasif", Int64.Type},
                {"OrdenFinca", Int64.Type},
                {"OrdenSexo", Int64.Type},
                {"OrdenEdad", Int64.Type},
                {"OrdenAntig", Int64.Type}
            }
        )
in
    #"Tipo cambiado"
