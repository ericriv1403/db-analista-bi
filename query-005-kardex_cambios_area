let
    Source =
        Sql.Database(
            "10.0.2.27\DataWareHousse,8699",
            "GestionHumana",
            [
                Query = "
WITH base AS (
    SELECT
        TRY_CONVERT(date, fecha) AS fecha,
        CAST(codigo_personal AS varchar(50)) AS codigo_personal,
        CAST(area_original AS varchar(255)) AS area_original
    FROM dbo.GHU_View_Maestro_Horas
    WHERE codigo_personal <> '001'
      AND codigo_personal IS NOT NULL
      AND area_original IS NOT NULL
      AND horas_presenciales IS NOT NULL
),
ordered AS (
    SELECT
        fecha,
        codigo_personal,
        area_original,
        LAG(area_original) OVER (PARTITION BY codigo_personal ORDER BY fecha) AS area_prev,
        CASE
            WHEN LAG(area_original) OVER (PARTITION BY codigo_personal ORDER BY fecha) IS NULL THEN 0
            WHEN area_original <> LAG(area_original) OVER (PARTITION BY codigo_personal ORDER BY fecha) THEN 1
            ELSE 0
        END AS is_change
    FROM base
),
seg AS (
    SELECT
        *,
        SUM(is_change) OVER (
            PARTITION BY codigo_personal
            ORDER BY fecha
            ROWS UNBOUNDED PRECEDING
        ) AS cambio_id
    FROM ordered
),
grp AS (
    SELECT
        codigo_personal,
        cambio_id,
        MIN(fecha) AS valid_from,
        MAX(area_original) AS area_original
    FROM seg
    GROUP BY codigo_personal, cambio_id
),
final AS (
    SELECT
        codigo_personal,
        area_original,
        valid_from,
        DATEADD(day, -1,
            LEAD(valid_from) OVER (PARTITION BY codigo_personal ORDER BY valid_from)
        ) AS valid_to
    FROM grp
)
SELECT
    codigo_personal,
    area_original,
    valid_from,
    COALESCE(valid_to, CONVERT(date,'9999-12-31')) AS valid_to
FROM final
ORDER BY codigo_personal, valid_from;
                "
            ]
        ),
    #"Filas filtradas" = Table.SelectRows(Source, each ([codigo_personal] = "2304"))
in
    #"Filas filtradas"
