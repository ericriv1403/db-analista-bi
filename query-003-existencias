let
    Origen =
        Sql.Database(
            "10.0.2.27\\DataWareHousse,8699",
            "GestionHumana",
            [
                Query = "
                    SET NOCOUNT ON;

                    DECLARE @FechaInicio date = '2020-09-01';
                    DECLARE @FechaFin    date = CAST(GETDATE() AS date);

                    /* ======================================
                       1) BASE ENTRADAS-SALIDAS DESDE HISTORIA_PERSONAL
                          + PERSONAL (Finca MH/SJ) CON LUGAR/REGIÓN REGISTRO
                       ====================================== */
                    WITH BaseMov AS (
                        SELECT
                            hp.Codigo_Personal,

                            -- LUGAR REGISTRO (PROVINCIA) SEGÚN DOS PRIMEROS DÍGITOS DE LA CÉDULA
                            CASE 
                                WHEN p.Cedula_de_Identidad IS NULL 
                                     OR LEN(LTRIM(RTRIM(p.Cedula_de_Identidad))) < 2 
                                    THEN NULL
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '01' THEN 'AZUAY'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '02' THEN 'BOLÍVAR'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '03' THEN 'CAÑAR'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '04' THEN 'CARCHI'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '05' THEN 'COTOPAXI'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '06' THEN 'CHIMBORAZO'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '07' THEN 'EL ORO'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '08' THEN 'ESMERALDAS'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '09' THEN 'GUAYAS'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '10' THEN 'IMBABURA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '11' THEN 'LOJA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '12' THEN 'LOS RÍOS'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '13' THEN 'MANABÍ'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '14' THEN 'MORONA SANTIAGO'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '15' THEN 'NAPO'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '16' THEN 'PASTAZA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '17' THEN 'PICHINCHA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '18' THEN 'TUNGURAHUA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '19' THEN 'ZAMORA CHINCHIPE'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '20' THEN 'GALÁPAGOS'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '21' THEN 'SUCUMBÍOS'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '22' THEN 'ORELLANA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '23' THEN 'SANTO DOMINGO DE LOS TSÁCHILAS'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '24' THEN 'SANTA ELENA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '30' THEN 'ECUATORIANOS RESIDENTES EN EL EXTERIOR'
                                ELSE NULL
                            END AS [Lugar Registro],

                            -- REGIÓN REGISTRO (SIERRA, COSTA, AMAZONÍA, INSULAR, EXTERIOR)
                            CASE 
                                WHEN p.Cedula_de_Identidad IS NULL 
                                     OR LEN(LTRIM(RTRIM(p.Cedula_de_Identidad))) < 2 
                                    THEN NULL
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) IN ('01','02','03','04','05','06','10','11','17','18')
                                    THEN 'SIERRA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) IN ('07','08','09','12','13','23','24')
                                    THEN 'COSTA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) IN ('14','15','16','19','21','22')
                                    THEN 'AMAZONÍA'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '20'
                                    THEN 'INSULAR'
                                WHEN SUBSTRING(LTRIM(RTRIM(p.Cedula_de_Identidad)), 1, 2) = '30'
                                    THEN 'EXTERIOR'
                                ELSE NULL
                            END AS [Región Registro],

                            CAST(hp.Fecha_Inicio_Evento AS date) AS Fecha_Ingreso,
                            CAST(hp.Fecha_Fin_Evento    AS date) AS Fecha_Salida
                        FROM dbo.Historia_Personal AS hp
                        INNER JOIN dbo.GHU_View_Maestro_Empleados AS me
                            ON hp.Codigo_Personal = me.Codigo_Personal
                        INNER JOIN dbo.Personal AS p
                            ON hp.Codigo_Personal = p.Codigo_Personal
                        WHERE
                            hp.Tipo_de_Evento = 'IS'                  -- Ingreso/Salida
                            AND hp.Fecha_Inicio_Evento IS NOT NULL
                            AND CAST(hp.Fecha_Inicio_Evento AS date) >= @FechaInicio
                            AND CAST(hp.Fecha_Inicio_Evento AS date) <= @FechaFin
                            AND me.Codigo_Personal NOT LIKE 'VC%'     -- excluye VC
                            AND me.Clasificacion_Personal IN ('AGR','OCAS','ADM')  -- AGR, ADM, OCAS
                            AND p.Finca IN ('MH', 'SJ')               -- solo fincas MH y SJ
                            AND p.A_Empresa = '2 - STARFLOWERS CIA. LTDA.'
                    ),

                    /* ======================================
                       2) CALENDARIO DÍA A DÍA
                       ====================================== */
                    Calendario AS (
                        SELECT @FechaInicio AS Fecha
                        UNION ALL
                        SELECT DATEADD(DAY, 1, Fecha)
                        FROM Calendario
                        WHERE Fecha < @FechaFin
                    ),

                    /* ======================================
                       2b) LISTA DE LUGAR REGISTRO + REGIÓN REGISTRO (DISTINTAS)
                       ====================================== */
                    DistLugarRegion AS (
                        SELECT DISTINCT
                            [Lugar Registro],
                            [Región Registro]
                        FROM BaseMov
                        WHERE [Lugar Registro] IS NOT NULL
                    ),

                    /* ======================================
                       2c) CALENDARIO x LUGAR REGISTRO x REGIÓN REGISTRO
                       ====================================== */
                    CalendarioLugar AS (
                        SELECT
                            c.Fecha,
                            d.[Lugar Registro],
                            d.[Región Registro]
                        FROM Calendario c
                        CROSS JOIN DistLugarRegion d
                    ),

                    /* ======================================
                       3) KÁRDEX PERSONA-DÍA (POR LUGAR/REGIÓN REGISTRO)
                          - Entradas/Salidas por día
                          - Existencias del día (personas activas ese día)
                          - Antigüedad ese día
                       ====================================== */
                    KardexPersonaDia AS (
                        SELECT
                            c.Fecha,
                            b.Codigo_Personal,
                            b.[Lugar Registro],
                            b.[Región Registro],
                            b.Fecha_Ingreso,
                            b.Fecha_Salida,

                            -- Entrada el día exacto de ingreso
                            CASE 
                                WHEN c.Fecha = b.Fecha_Ingreso THEN 1 
                                ELSE 0 
                            END AS EsEntrada,

                            -- Salida el día exacto de salida
                            CASE 
                                WHEN b.Fecha_Salida IS NOT NULL
                                     AND c.Fecha = b.Fecha_Salida THEN 1
                                ELSE 0
                            END AS EsSalida,

                            -- Activo en el día (al cierre del día)
                            -- Intervalo [Fecha_Ingreso, Fecha_Salida)
                            CASE 
                                WHEN c.Fecha >= b.Fecha_Ingreso
                                     AND (b.Fecha_Salida IS NULL OR c.Fecha < b.Fecha_Salida)
                                THEN 1 ELSE 0 
                            END AS Activo_Dia,

                            -- Días de antigüedad en ese día
                            CASE 
                                WHEN c.Fecha >= b.Fecha_Ingreso
                                     AND (b.Fecha_Salida IS NULL OR c.Fecha < b.Fecha_Salida)
                                THEN DATEDIFF(DAY, b.Fecha_Ingreso, c.Fecha)
                                ELSE NULL
                            END AS Dias_Antiguedad
                        FROM Calendario c
                        JOIN BaseMov b
                          ON c.Fecha >= b.Fecha_Ingreso
                         AND c.Fecha <= ISNULL(b.Fecha_Salida, @FechaFin)
                    ),

                    /* ======================================
                       4) RESUMEN DIARIO POR ANTIGÜEDAD, LUGAR Y REGIÓN REGISTRO
                       ====================================== */
                    ResumenExistencias AS (
                        SELECT
                            Fecha,
                            [Lugar Registro],
                            [Región Registro],
                            SUM(EsEntrada) AS Entradas,
                            SUM(EsSalida)  AS Salidas,

                            -- Existencias del día (personas activas ese día)
                            SUM(Activo_Dia) AS Existencias_Total,

                            -- Existencias con > 1 año de antigüedad
                            SUM(
                                CASE 
                                    WHEN Activo_Dia = 1
                                         AND Dias_Antiguedad > 365 
                                    THEN 1 ELSE 0 
                                END
                            ) AS Existencias_Mas_1_Anio,

                            -- Existencias con <= 1 año de antigüedad
                            SUM(
                                CASE 
                                    WHEN Activo_Dia = 1
                                         AND Dias_Antiguedad <= 365 
                                    THEN 1 ELSE 0 
                                END
                            ) AS Existencias_Menos_1_Anio
                        FROM KardexPersonaDia
                        GROUP BY Fecha, [Lugar Registro], [Región Registro]
                    )

                    /* ======================================
                       5) SALIDA FINAL (CALENDARIO COMPLETO x LUGAR x REGIÓN REGISTRO)
                       ====================================== */
                    SELECT
                        cl.Fecha,
                        cl.[Lugar Registro],
                        cl.[Región Registro],
                        ISNULL(r.Entradas, 0)                 AS Entradas,
                        ISNULL(r.Salidas, 0)                  AS Salidas,
                        ISNULL(r.Existencias_Total, 0)        AS Existencias_Total,
                        ISNULL(r.Existencias_Mas_1_Anio, 0)   AS Existencias_Mas_1_Anio,
                        ISNULL(r.Existencias_Menos_1_Anio, 0) AS Existencias_Menos_1_Anio
                    FROM CalendarioLugar cl
                    LEFT JOIN ResumenExistencias r
                      ON cl.Fecha           = r.Fecha
                     AND cl.[Lugar Registro]  = r.[Lugar Registro]
                     AND cl.[Región Registro] = r.[Región Registro]
                    ORDER BY cl.Fecha, cl.[Lugar Registro], cl.[Región Registro]
                    OPTION (MAXRECURSION 32767);
                "
            ]
        ),

    #"Tipo cambiado" =
        Table.TransformColumnTypes(
            Origen,
            {
                {"Fecha", type date},
                {"Lugar Registro", type text},
                {"Región Registro", type text},
                {"Entradas", Int64.Type},
                {"Salidas", Int64.Type},
                {"Existencias_Total", Int64.Type},
                {"Existencias_Mas_1_Anio", Int64.Type},
                {"Existencias_Menos_1_Anio", Int64.Type}
            }
        )
in
    #"Tipo cambiado"
